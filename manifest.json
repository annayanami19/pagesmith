{
  "manifest_version": 3,
  "name": "Pagesmith — Live Page Editor",
  "short_name": "Pagesmith",
  "version": "1.0.0",
  "description": "Ubah teks, atribut, dan nilai form di halaman web tanpa membuka Inspect. Sekali pakai atau disimpan per domain.",
  "minimum_chrome_version": "106",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pagesmith",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Aktifkan/matikan mode pilih elemen"
    },
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Tampilkan/sembunyikan panel editor"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
